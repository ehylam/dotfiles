{
  "// Types & Interfaces": {},
  "int": { "prefix": "int", "body": ["interface ${1:Name} {", "\t${0}", "}"] },
  "type": { "prefix": "type", "body": "type ${1:Name} = ${0};" },
  "enum": { "prefix": "enum", "body": ["enum ${1:Name} {", "\t${0}", "}"] },
  "const enum": { "prefix": "cenum", "body": ["const enum ${1:Name} {", "\t${0}", "}"] },
  
  "// Classes": {},
  "class": { "prefix": "cls", "body": ["class ${1:Name} {", "\t${0}", "}"] },
  "abstract class": { "prefix": "acls", "body": ["abstract class ${1:Name} {", "\t${0}", "}"] },
  "class extends": { "prefix": "clse", "body": ["class ${1:Name} extends ${2:Base} {", "\t${0}", "}"] },
  "class implements": { "prefix": "clsi", "body": ["class ${1:Name} implements ${2:Interface} {", "\t${0}", "}"] },
  "class extends implements": { "prefix": "clsei", "body": ["class ${1:Name} extends ${2:Base} implements ${3:Interface} {", "\t${0}", "}"] },
  
  "// Class Members": {},
  "public property": { "prefix": "pub", "body": "public ${1:name}: ${2:type};" },
  "private property": { "prefix": "priv", "body": "private ${1:name}: ${2:type};" },
  "protected property": { "prefix": "prot", "body": "protected ${1:name}: ${2:type};" },
  "readonly property": { "prefix": "ro", "body": "readonly ${1:name}: ${2:type};" },
  "static property": { "prefix": "static", "body": "static ${1:name}: ${2:type};" },
  
  "// Methods": {},
  "public method": { "prefix": "pubm", "body": ["public ${1:name}(${2:params}): ${3:void} {", "\t${0}", "}"] },
  "private method": { "prefix": "privm", "body": ["private ${1:name}(${2:params}): ${3:void} {", "\t${0}", "}"] },
  "protected method": { "prefix": "protm", "body": ["protected ${1:name}(${2:params}): ${3:void} {", "\t${0}", "}"] },
  "async method": { "prefix": "asyncm", "body": ["async ${1:name}(${2:params}): Promise<${3:void}> {", "\t${0}", "}"] },
  
  "// Functions": {},
  "typed function": { "prefix": "tfn", "body": ["function ${1:name}(${2:params}): ${3:void} {", "\t${0}", "}"] },
  "arrow function": { "prefix": "afn", "body": "const ${1:name} = (${2:params}): ${3:void} => ${0};" },
  "arrow function block": { "prefix": "afnb", "body": ["const ${1:name} = (${2:params}): ${3:void} => {", "\t${0}", "};"] },
  "async function": { "prefix": "asfn", "body": ["async function ${1:name}(${2:params}): Promise<${3:void}> {", "\t${0}", "}"] },
  "async arrow": { "prefix": "asafn", "body": ["const ${1:name} = async (${2:params}): Promise<${3:void}> => {", "\t${0}", "};"] },
  
  "// Generics": {},
  "generic function": { "prefix": "gfn", "body": ["function ${1:name}<${2:T}>(${3:params}): ${4:T} {", "\t${0}", "}"] },
  "generic arrow": { "prefix": "gafn", "body": "const ${1:name} = <${2:T}>(${3:params}): ${4:T} => ${0};" },
  "generic interface": { "prefix": "gint", "body": ["interface ${1:Name}<${2:T}> {", "\t${0}", "}"] },
  "generic class": { "prefix": "gcls", "body": ["class ${1:Name}<${2:T}> {", "\t${0}", "}"] },
  "generic constraint": { "prefix": "gcon", "body": "<${1:T} extends ${2:Type}>" },
  
  "// Type Guards & Assertions": {},
  "type guard": { "prefix": "tguard", "body": ["function ${1:isType}(${2:value}: ${3:any}): ${2:value} is ${4:Type} {", "\t${0}", "}"] },
  "as assertion": { "prefix": "as", "body": "${1:value} as ${2:Type}" },
  "angle assertion": { "prefix": "angle", "body": "<${2:Type}>${1:value}" },
  "non-null assertion": { "prefix": "nn", "body": "${1:value}!" },
  
  "// Decorators": {},
  "class decorator": { "prefix": "cdec", "body": ["function ${1:Decorator}(target: typeof ${2:Class}) {", "\t${0}", "}"] },
  "method decorator": { "prefix": "mdec", "body": ["function ${1:Decorator}(target: any, propertyKey: string, descriptor: PropertyDescriptor) {", "\t${0}", "}"] },
  "property decorator": { "prefix": "pdec", "body": ["function ${1:Decorator}(target: any, propertyKey: string) {", "\t${0}", "}"] },
  
  "// Utility Types": {},
  "partial": { "prefix": "partial", "body": "Partial<${1:Type}>" },
  "required": { "prefix": "required", "body": "Required<${1:Type}>" },
  "readonly": { "prefix": "readonly", "body": "Readonly<${1:Type}>" },
  "record": { "prefix": "record", "body": "Record<${1:Keys}, ${2:Type}>" },
  "pick": { "prefix": "pick", "body": "Pick<${1:Type}, ${2:Keys}>" },
  "omit": { "prefix": "omit", "body": "Omit<${1:Type}, ${2:Keys}>" },
  "exclude": { "prefix": "exclude", "body": "Exclude<${1:Type}, ${2:ExcludedUnion}>" },
  "extract": { "prefix": "extract", "body": "Extract<${1:Type}, ${2:Union}>" },
  "nonnullable": { "prefix": "nonnull", "body": "NonNullable<${1:Type}>" },
  "returntype": { "prefix": "rettype", "body": "ReturnType<typeof ${1:function}>" },
  
  "// Modules": {},
  "namespace": { "prefix": "ns", "body": ["namespace ${1:Name} {", "\t${0}", "}"] },
  "module": { "prefix": "mod", "body": ["module ${1:Name} {", "\t${0}", "}"] },
  "declare module": { "prefix": "dmod", "body": ["declare module '${1:module}' {", "\t${0}", "}"] },
  "export type": { "prefix": "expt", "body": "export type ${1:Name} = ${0};" },
  "export interface": { "prefix": "expi", "body": ["export interface ${1:Name} {", "\t${0}", "}"] },
  "export enum": { "prefix": "expe", "body": ["export enum ${1:Name} {", "\t${0}", "}"] },
  
  "// Common Patterns": {},
  "constructor": { "prefix": "ctor", "body": ["constructor(${1:params}) {", "\t${0}", "}"] },
  "getter": { "prefix": "get", "body": ["get ${1:property}(): ${2:type} {", "\treturn ${0};", "}"] },
  "setter": { "prefix": "set", "body": ["set ${1:property}(value: ${2:type}) {", "\t${0}", "}"] },
  "try catch": { "prefix": "tc", "body": ["try {", "\t${1}", "} catch (${2:error}) {", "\t${0}", "}"] },
  "try catch finally": { "prefix": "tcf", "body": ["try {", "\t${1}", "} catch (${2:error}) {", "\t${3}", "} finally {", "\t${0}", "}"] },
  "throw error": { "prefix": "throw", "body": "throw new Error('${1:message}');" },
  
  "// React Types (bonus)": {},
  "react fc": { "prefix": "rfc", "body": ["const ${1:Component}: React.FC<${2:Props}> = (${3:props}) => {", "\t${0}", "};"] },
  "react props": { "prefix": "rprops", "body": ["interface ${1:Component}Props {", "\t${0}", "}"] },
  "react state": { "prefix": "rstate", "body": "const [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState<${2:type}>(${3:initial});" }
}
