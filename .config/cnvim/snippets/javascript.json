{
  "imp": { "prefix": "imp", "body": "import ${2:moduleName} from '${1:module}';$0" },
  "imn": { "prefix": "imn", "body": "import '${1:module}';$0" },
  "imd": { "prefix": "imd", "body": "import { $2 } from '${1:module}';$0" },
  "ime": { "prefix": "ime", "body": "import * as ${2:alias} from '${1:module}';$0" },
  "ima": { "prefix": "ima", "body": "import { ${2:originalName} as ${3:alias} } from '${1:module}';$0" },
  "rqr": { "prefix": "rqr", "body": "require('${1:package}');" },
  "req": { "prefix": "req", "body": "const ${1:packageName} = require('${1:package}');$0" },
  "mde": { "prefix": "mde", "body": ["module.exports = {", "\t$0", "};"] },
  "env": { "prefix": "env", "body": "export const ${1:exportVariable} = ${2:localVariable};" },
  "enf": { "prefix": "enf", "body": ["export const ${1:functionName} = (${2:params}) => {", "\t$0", "};"] },
  "edf": { "prefix": "edf", "body": ["export default function ${1:${TM_FILENAME_BASE}}(${2:params}) {", "\t$0", "};"] },
  "ecl": { "prefix": "ecl", "body": ["export default class ${1:className} {", "\t$0", "};"] },
  "ece": { "prefix": "ece", "body": ["export default class ${1:className} extends ${2:baseclassName} {", "\t$0", "};"] },
  "con": { "prefix": "con", "body": ["constructor(${1:params}) {", "\t${0}", "}"] },
  "met": { "prefix": "met", "body": ["${1:methodName}(${2:params}) {", "\t${0}", "}"] },
  "pge": { "prefix": "pge", "body": ["get ${1:propertyName}() {", "\treturn this.${0};", "}"] },
  "pse": { "prefix": "pse", "body": ["set ${1:propertyName}(${2:value}) {", "\t${0};", "}"] },
  "fre": { "prefix": "fre", "body": ["${1:array}.forEach(${2:currentItem} => {", "\t${0}", "});"] },
  "fof": { "prefix": "fof", "body": ["for (const ${1:item} of ${2:object}) {", "\t${0}", "}"] },
  "fin": { "prefix": "fin", "body": ["for (const ${1:item} in ${2:object}) {", "\t${0}", "}"] },
  "anfn": { "prefix": "anfn", "body": ["(${1:params}) => {", "\t${2}", "}"] },
  "nfn": { "prefix": "nfn", "body": ["const ${1:name} = (${2:params}) => {", "\t${3}", "}"] },
  "dob": { "prefix": "dob", "body": "const {${2:propertyName}} = ${1:objectToDestruct};" },
  "dar": { "prefix": "dar", "body": "const [${2:propertyName}] = ${1:arrayToDestruct};" },
  "sti": { "prefix": "sti", "body": ["setInterval(() => {", "\t${2}", "}, ${0:intervalInms});"] },
  "sto": { "prefix": "sto", "body": ["setTimeout(() => {", "\t${2}", "}, ${1:delayInms});"] },
  "prom": { "prefix": "prom", "body": ["return new Promise((resolve, reject) => {", "\t${1}", "});"] },
  "thenc": { "prefix": "thenc", "body": [".then((${1:result}) => {", "\t${2}", "}).catch((${3:err}) => {", "\t${4}", "});"] },
  "cas": { "prefix": "cas", "body": "console.assert(${1:expression}, ${2:object});" },
  "ccl": { "prefix": "ccl", "body": "console.clear();" },
  "cco": { "prefix": "cco", "body": "console.count(${1:label});" },
  "cdb": { "prefix": "cdb", "body": "console.debug(${1:object});" },
  "cdi": { "prefix": "cdi", "body": "console.dir(${1:object});" },
  "cer": { "prefix": "cer", "body": "console.error(${1:object});" },
  "cgr": { "prefix": "cgr", "body": "console.group('${1:label}');" },
  "cge": { "prefix": "cge", "body": "console.groupEnd();" },
  "clg": { "prefix": "clg", "body": "console.log(${1:object});" },
  "clo": { "prefix": "clo", "body": "console.log('${1:object} :>> ', ${1:object});" },
  "ctr": { "prefix": "ctr", "body": "console.trace(${1:object});" },
  "cwa": { "prefix": "cwa", "body": "console.warn(${1:object});" },
  "cin": { "prefix": "cin", "body": "console.info(${1:object});" },
  "clt": { "prefix": "clt", "body": "console.table(${1:object});" },
  "cti": { "prefix": "cti", "body": "console.time(${1:object});" },
  "cte": { "prefix": "cte", "body": "console.timeEnd(${1:object});" }
}
