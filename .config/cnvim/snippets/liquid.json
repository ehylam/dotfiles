{
  "frontmatter": { "prefix": "frontmatter", "body": ["---", "$2", "---"] },
  "if": { "prefix": "if", "body": ["{% if ${1:condition} %}", "\t$2", "{% endif %}"] },
  "else": { "prefix": "else", "body": ["{% else %}", "\t"] },
  "elsif": { "prefix": "elsif", "body": ["{% elsif ${1:condition} %}", "\t"] },
  "if elsif": { "prefix": "if elsif", "body": ["{% if ${1:condition} %}", "\t$2", "{% elsif ${3:condition} %}", "\t$4", "{% endif %}"] },
  "if else": { "prefix": "if else", "body": ["{% if ${1:condition} %}", "\t$2", "{% else %}", "\t$3", "{% endif %}"] },
  "unless": { "prefix": "unless", "body": ["{% unless ${1:condition} %}", "\t$2", "{% endunless %}"] },
  "unless else": { "prefix": "unless else", "body": ["{% unless ${1:condition} %}", "\t$2", "{% else %}", "\t$3", "{% endunless %}"] },
  "case": { "prefix": "case", "body": ["{% case ${1:variable} %}", "\t{% when ${2:condition} %}", "\t\t$3", "\t{% else %}", "\t\t$4", "{% endcase %}"] },
  "when": { "prefix": "when", "body": ["{% when ${1:condition} %}", "$0"] },
  "cycle": { "prefix": "cycle", "body": "{% cycle '${1:odd}', '${2:even}' %}" },
  "cycle group": { "prefix": "cycle group", "body": "{% cycle '${1:group name}': '${2:odd}', '${3:even}' %}" },
  "for": { "prefix": "for", "body": ["{% for ${1:item} in ${2:collection} %}", "\t$3", "{% endfor %}"] },
  "break": { "prefix": "break", "body": "{% break %}" },
  "continue": { "prefix": "continue", "body": "{% continue %}" },
  "tablerow": { "prefix": "tablerow", "body": ["{% tablerow ${1:item} in ${2:collection} cols: ${3:2} %}", "\t$4", "{% endtablerow %}"] },
  "assign": { "prefix": "assign", "body": "{% assign ${1:variable} = ${2:value} %}" },
  "increment": { "prefix": "increment", "body": "{% increment ${1:variable} %}" },
  "decrement": { "prefix": "decrement", "body": "{% decrement ${1:variable} %}" },
  "capture": { "prefix": "capture", "body": ["{% capture ${1:variable} %}", "\t$2", "{% endcapture %}"] },
  "liquid": { "prefix": "liquid", "body": ["{% liquid", "\t$1", "%}"] },
  "render": { "prefix": "render", "body": "{% render $1 %}" },
  "render with": { "prefix": "render", "body": "{% render $1, ${2:param}: ${3:value}" },
  "include": { "prefix": "include", "body": "{% include $1 %}" },
  "include with": { "prefix": "includewith", "body": "{% include 1, ${2:param}: ${3:value} %}" },
  "section": { "prefix": "section", "body": "{% section $1 %}" },
  "sections": { "prefix": "sections", "body": "{% sections '${1:group}' %}" },
  "raw": { "prefix": "raw", "body": ["{% raw %}", "\t$1", "{% endraw %}"] },
  "layout": { "prefix": "layout", "body": "{% layout '${1:layout}' %}" },
  "form": { "prefix": "form", "body": ["{% form '${1:name}', ${2:product} %}", "\t$3", "{% endform %}"] },
  "paginate": { "prefix": "paginate", "body": ["{% paginate ${1:collection.products} by ${2:12} %}", "\t{% for ${3:product} in ${1:collection.products} %}", "\t\t$4", "\t{% endfor %}", "{% endpaginate %}"] },
  "schema": { "prefix": "schema", "body": ["{% schema %}", "{", "\t\"name\": \"$1\",", "\t\"settings\": [", "\t\t$0", "\t]", "}", "{% endschema %}"] },
  "style": { "prefix": "style", "body": ["{% style %}", "\t$1", "{% endstyle %}"] },
  "stylesheet": { "prefix": "stylesheet", "body": ["{% stylesheet %}", "\t$1", "{% endstylesheet %}"] },
  "javascript": { "prefix": "javascript", "body": ["{% javascript %}", "\t$1", "{% endjavascript %}"] },
  "comment line": { "prefix": "#", "body": "{% # $2 %}" },
  "comment": { "prefix": "comment", "body": ["{% comment %}", "\t${1|esthetic-ignore,esthetic-ignore-start,esthetic-ignore-end,esthetic-ignore-next|}", "{% endcomment %}"] },
  "esthetic-ignore": { "prefix": "esthetic-", "body": "{% # esthetic-ignore %}" },
  "esthetic-ignore-next": { "prefix": "esthetic-", "body": "{% # esthetic-ignore-next %}" },
  "esthetic-ignore-start": { "prefix": "esthetic-", "body": "{% comment %}esthetic-ignore-start{% endcomment %}" },
  "esthetic-ignore-end": { "prefix": "esthetic-", "body": "{% comment %}esthetic-ignore-end{% endcomment %}" },
  "_checkbox": { "prefix": "_checkbox", "body": ["{\n  \"type\": \"checkbox\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"default\": ${3|true,false|}\n}${4:,}"] },
  "_number": { "prefix": "_number", "body": ["{\n  \"type\": \"number\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"default\": $3\n}${4:,}"] },
  "_option": { "prefix": "_option", "body": ["{\n  \"value\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_radio": { "prefix": "_radio", "body": ["{\n  \"type\": \"radio\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"options\": [\n    {\n      \"value\": \"$3\",\n      \"label\": \"$4\"\n    },\n    $0\n  ],\n  \"default\": \"$3\"\n}${5:,}"] },
  "_range": { "prefix": "_range", "body": ["{\n  \"type\": \"range\",\n  \"id\": \"$1\",\n  \"min\": $2,\n  \"max\": $3,\n  \"step\": $4,\n  \"unit\": \"$5\",\n  \"label\": \"$6\",\n  \"default\": $7\n}${8:,}"] },
  "_select": { "prefix": "_select", "body": ["{\n  \"type\": \"select\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"options\": [\n    {\n      \"value\": \"$3\",\n      \"label\": \"$4\"\n    },\n    $0\n  ],\n  \"default\": \"$3\"\n}${5:,}"] },
  "_text": { "prefix": "_text", "body": ["{\n  \"type\": \"text\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_textarea": { "prefix": "_textarea", "body": ["{\n  \"type\": \"textarea\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_article": { "prefix": "_article", "body": ["{\n  \"type\": \"article\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_blog": { "prefix": "_blog", "body": ["{\n  \"type\": \"blog\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_collection": { "prefix": "_collection", "body": ["{\n  \"type\": \"collection\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_collection_list": { "prefix": "_collection_list", "body": ["{\n  \"type\": \"collection_list\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"limit\": $3\n}${4:,}"] },
  "_color": { "prefix": "_color", "body": ["{\n  \"type\": \"color\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"default\": \"${3:#000000}\"\n}${4:,}"] },
  "_color_background": { "prefix": "_color_background", "body": ["{\n  \"type\": \"color_background\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"default\": \"${3:#000000}\"\n}${4:,}"] },
  "_font_picker": { "prefix": "_font_picker", "body": ["{\n  \"type\": \"font_picker\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"default\": \"${3:helvetica_n4}\"\n}${4:,}"] },
  "_html": { "prefix": "_html", "body": ["{\n  \"type\": \"html\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_image_picker": { "prefix": "_image_picker", "body": ["{\n  \"type\": \"image_picker\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_inline_richtext": { "prefix": "_inline_richtext", "body": ["{\n  \"type\": \"inline_richtext\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_link_list": { "prefix": "_link_list", "body": ["{\n  \"type\": \"link_list\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_liquid": { "prefix": "_liquid", "body": ["{\n  \"type\": \"liquid\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_page": { "prefix": "_page", "body": ["{\n  \"type\": \"page\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_product": { "prefix": "_product", "body": ["{\n  \"type\": \"product\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_product_list": { "prefix": "_product_list", "body": ["{\n  \"type\": \"product_list\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"limit\": $3\n}${4:,}"] },
  "_richtext": { "prefix": "_richtext", "body": ["{\n  \"type\": \"richtext\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_url": { "prefix": "_url", "body": ["{\n  \"type\": \"url\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_video": { "prefix": "_video", "body": ["{\n  \"type\": \"video\",\n  \"id\": \"$1\",\n  \"label\": \"$2\"\n}${3:,}"] },
  "_video_url": { "prefix": "_video_url", "body": ["{\n  \"type\": \"video_url\",\n  \"id\": \"$1\",\n  \"label\": \"$2\",\n  \"accept\": [\n    \"youtube\",\n    \"vimeo\"\n  ]\n}${3:,}"] },
  "_header": { "prefix": "_header", "body": ["{\n  \"type\": \"header\",\n  \"content\": \"$1\"\n}${3:,}"] },
  "_paragraph": { "prefix": "_paragraph", "body": ["{\n  \"type\": \"paragraph\",\n  \"content\": \"$1\"\n}${3:,}"] },
  "block": { "prefix": "block", "body": ["\"blocks\": [\n  {\n    \"name\": \"$1\",\n    \"type\": \"$2\",\n    \"settings\": [\n      $0\n    ]\n  }\n],"] }
}
