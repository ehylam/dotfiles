{
  "// Document": {},
  "html5": { "prefix": "html5", "body": ["<!DOCTYPE html>", "<html lang=\"${1:en}\">", "<head>", "\t<meta charset=\"UTF-8\">", "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">", "\t<title>${2:Document}</title>", "</head>", "<body>", "\t$0", "</body>", "</html>"] },
  "html": { "prefix": "html", "body": ["<html>", "\t$0", "</html>"] },
  "head": { "prefix": "head", "body": ["<head>", "\t$0", "</head>"] },
  "body": { "prefix": "body", "body": ["<body>", "\t$0", "</body>"] },
  "doctype": { "prefix": "doctype", "body": "<!DOCTYPE html>" },
  
  "// Meta Tags": {},
  "meta": { "prefix": "meta", "body": "<meta ${1:attr}=\"${2:value}\">" },
  "meta charset": { "prefix": "metac", "body": "<meta charset=\"${1:UTF-8}\">" },
  "meta viewport": { "prefix": "metav", "body": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">" },
  "meta description": { "prefix": "metad", "body": "<meta name=\"description\" content=\"${1:description}\">" },
  "meta keywords": { "prefix": "metak", "body": "<meta name=\"keywords\" content=\"${1:keywords}\">" },
  "meta author": { "prefix": "metaa", "body": "<meta name=\"author\" content=\"${1:name}\">" },
  "meta og": { "prefix": "metaog", "body": "<meta property=\"og:${1:title}\" content=\"${2:content}\">" },
  
  "// Links": {},
  "link": { "prefix": "link", "body": "<link rel=\"${1:stylesheet}\" href=\"${2:path}\">" },
  "css": { "prefix": "css", "body": "<link rel=\"stylesheet\" href=\"${1:style.css}\">" },
  "favicon": { "prefix": "favicon", "body": "<link rel=\"icon\" type=\"image/x-icon\" href=\"${1:favicon.ico}\">" },
  "style": { "prefix": "style", "body": ["<style>", "\t$0", "</style>"] },
  
  "// Scripts": {},
  "script": { "prefix": "script", "body": "<script src=\"${1:script.js}\"></script>" },
  "script inline": { "prefix": "scripts", "body": ["<script>", "\t$0", "</script>"] },
  "script async": { "prefix": "scripta", "body": "<script src=\"${1:script.js}\" async></script>" },
  "script defer": { "prefix": "scriptd", "body": "<script src=\"${1:script.js}\" defer></script>" },
  "noscript": { "prefix": "noscript", "body": ["<noscript>", "\t$0", "</noscript>"] },
  
  "// Structure": {},
  "div": { "prefix": "div", "body": ["<div>", "\t$0", "</div>"] },
  "div class": { "prefix": "divc", "body": ["<div class=\"${1:class}\">", "\t$0", "</div>"] },
  "div id": { "prefix": "divi", "body": ["<div id=\"${1:id}\">", "\t$0", "</div>"] },
  "span": { "prefix": "span", "body": "<span>$0</span>" },
  "span class": { "prefix": "spanc", "body": "<span class=\"${1:class}\">$0</span>" },
  
  "// Semantic HTML": {},
  "header": { "prefix": "header", "body": ["<header>", "\t$0", "</header>"] },
  "nav": { "prefix": "nav", "body": ["<nav>", "\t$0", "</nav>"] },
  "main": { "prefix": "main", "body": ["<main>", "\t$0", "</main>"] },
  "section": { "prefix": "section", "body": ["<section>", "\t$0", "</section>"] },
  "article": { "prefix": "article", "body": ["<article>", "\t$0", "</article>"] },
  "aside": { "prefix": "aside", "body": ["<aside>", "\t$0", "</aside>"] },
  "footer": { "prefix": "footer", "body": ["<footer>", "\t$0", "</footer>"] },
  "figure": { "prefix": "figure", "body": ["<figure>", "\t<img src=\"${1:image}\" alt=\"${2:alt}\">", "\t<figcaption>${3:caption}</figcaption>", "</figure>"] },
  
  "// Headings & Text": {},
  "h1": { "prefix": "h1", "body": "<h1>$0</h1>" },
  "h2": { "prefix": "h2", "body": "<h2>$0</h2>" },
  "h3": { "prefix": "h3", "body": "<h3>$0</h3>" },
  "h4": { "prefix": "h4", "body": "<h4>$0</h4>" },
  "h5": { "prefix": "h5", "body": "<h5>$0</h5>" },
  "h6": { "prefix": "h6", "body": "<h6>$0</h6>" },
  "p": { "prefix": "p", "body": "<p>$0</p>" },
  "br": { "prefix": "br", "body": "<br>" },
  "hr": { "prefix": "hr", "body": "<hr>" },
  "blockquote": { "prefix": "blockquote", "body": ["<blockquote>", "\t$0", "</blockquote>"] },
  "pre": { "prefix": "pre", "body": ["<pre>", "$0", "</pre>"] },
  "code": { "prefix": "code", "body": "<code>$0</code>" },
  
  "// Lists": {},
  "ul": { "prefix": "ul", "body": ["<ul>", "\t<li>$0</li>", "</ul>"] },
  "ol": { "prefix": "ol", "body": ["<ol>", "\t<li>$0</li>", "</ol>"] },
  "li": { "prefix": "li", "body": "<li>$0</li>" },
  "dl": { "prefix": "dl", "body": ["<dl>", "\t<dt>${1:term}</dt>", "\t<dd>${2:description}</dd>", "</dl>"] },
  
  "// Links & Media": {},
  "a": { "prefix": "a", "body": "<a href=\"${1:url}\">$0</a>" },
  "a blank": { "prefix": "ab", "body": "<a href=\"${1:url}\" target=\"_blank\" rel=\"noopener noreferrer\">$0</a>" },
  "a mailto": { "prefix": "amail", "body": "<a href=\"mailto:${1:email}\">$0</a>" },
  "a tel": { "prefix": "atel", "body": "<a href=\"tel:${1:phone}\">$0</a>" },
  "img": { "prefix": "img", "body": "<img src=\"${1:image}\" alt=\"${2:alt}\">" },
  "picture": { "prefix": "picture", "body": ["<picture>", "\t<source srcset=\"${1:image.webp}\" type=\"image/webp\">", "\t<img src=\"${2:image.jpg}\" alt=\"${3:alt}\">", "</picture>"] },
  "video": { "prefix": "video", "body": ["<video controls>", "\t<source src=\"${1:video.mp4}\" type=\"video/mp4\">", "\t${2:Your browser does not support the video tag.}", "</video>"] },
  "audio": { "prefix": "audio", "body": ["<audio controls>", "\t<source src=\"${1:audio.mp3}\" type=\"audio/mpeg\">", "\t${2:Your browser does not support the audio tag.}", "</audio>"] },
  "iframe": { "prefix": "iframe", "body": "<iframe src=\"${1:url}\" width=\"${2:600}\" height=\"${3:400}\"></iframe>" },
  
  "// Forms": {},
  "form": { "prefix": "form", "body": ["<form action=\"${1:action}\" method=\"${2:post}\">", "\t$0", "</form>"] },
  "input": { "prefix": "input", "body": "<input type=\"${1:text}\" name=\"${2:name}\" id=\"${3:id}\">" },
  "input text": { "prefix": "intext", "body": "<input type=\"text\" name=\"${1:name}\" id=\"${2:id}\" placeholder=\"${3:placeholder}\">" },
  "input email": { "prefix": "inemail", "body": "<input type=\"email\" name=\"${1:email}\" id=\"${2:email}\" placeholder=\"${3:Email}\">" },
  "input password": { "prefix": "inpass", "body": "<input type=\"password\" name=\"${1:password}\" id=\"${2:password}\">" },
  "input number": { "prefix": "innum", "body": "<input type=\"number\" name=\"${1:number}\" id=\"${2:number}\" min=\"${3:0}\" max=\"${4:100}\">" },
  "input checkbox": { "prefix": "incheck", "body": "<input type=\"checkbox\" name=\"${1:name}\" id=\"${2:id}\" value=\"${3:value}\">" },
  "input radio": { "prefix": "inradio", "body": "<input type=\"radio\" name=\"${1:name}\" id=\"${2:id}\" value=\"${3:value}\">" },
  "input file": { "prefix": "infile", "body": "<input type=\"file\" name=\"${1:file}\" id=\"${2:file}\" accept=\"${3:image/*}\">" },
  "input submit": { "prefix": "insubmit", "body": "<input type=\"submit\" value=\"${1:Submit}\">" },
  "button": { "prefix": "button", "body": "<button type=\"${1:button}\">$0</button>" },
  "textarea": { "prefix": "textarea", "body": "<textarea name=\"${1:name}\" id=\"${2:id}\" rows=\"${3:4}\" cols=\"${4:50}\">$0</textarea>" },
  "select": { "prefix": "select", "body": ["<select name=\"${1:name}\" id=\"${2:id}\">", "\t<option value=\"${3:value}\">${4:Option}</option>", "\t$0", "</select>"] },
  "option": { "prefix": "option", "body": "<option value=\"${1:value}\">$0</option>" },
  "label": { "prefix": "label", "body": "<label for=\"${1:id}\">$0</label>" },
  "fieldset": { "prefix": "fieldset", "body": ["<fieldset>", "\t<legend>${1:Legend}</legend>", "\t$0", "</fieldset>"] },
  
  "// Tables": {},
  "table": { "prefix": "table", "body": ["<table>", "\t<thead>", "\t\t<tr>", "\t\t\t<th>${1:Header}</th>", "\t\t</tr>", "\t</thead>", "\t<tbody>", "\t\t<tr>", "\t\t\t<td>$0</td>", "\t\t</tr>", "\t</tbody>", "</table>"] },
  "tr": { "prefix": "tr", "body": ["<tr>", "\t$0", "</tr>"] },
  "th": { "prefix": "th", "body": "<th>$0</th>" },
  "td": { "prefix": "td", "body": "<td>$0</td>" },
  
  "// Other": {},
  "comment": { "prefix": "com", "body": "<!-- $0 -->" },
  "lorem": { "prefix": "lorem", "body": "Lorem ipsum dolor sit amet, consectetur adipisicing elit." },
  "details": { "prefix": "details", "body": ["<details>", "\t<summary>${1:Summary}</summary>", "\t$0", "</details>"] },
  "template": { "prefix": "template", "body": ["<template>", "\t$0", "</template>"] },
  "canvas": { "prefix": "canvas", "body": "<canvas id=\"${1:canvas}\" width=\"${2:800}\" height=\"${3:600}\"></canvas>" },
  "progress": { "prefix": "progress", "body": "<progress value=\"${1:70}\" max=\"${2:100}\"></progress>" },
  "meter": { "prefix": "meter", "body": "<meter value=\"${1:6}\" min=\"${2:0}\" max=\"${3:10}\"></meter>" }
}
