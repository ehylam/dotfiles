font-family = CommitMono Nerd Font
adjust-cell-height=30%
theme = Dracula
macos-option-as-alt = true
macos-non-native-fullscreen = true
command = /opt/homebrew/bin/fish --login --interactive

keybind = ctrl+a>t>n=new_tab
keybind = ctrl+a>p>l=new_split:right
keybind = ctrl+a>p>h=new_split:left
keybind = ctrl+a>p>k=new_split:up
keybind = ctrl+a>p>j=new_split:down

keybind = ctrl+a>p>right=goto_split:right
keybind = ctrl+a>p>left=goto_split:left
keybind = ctrl+a>p>up=goto_split:up
keybind = ctrl+a>p>down=goto_split:down

keybind = ctrl+a>r>right=resize_split:right,250
keybind = ctrl+a>r>left=resize_split:left,250
keybind = ctrl+a>r>up=resize_split:up,150
keybind = ctrl+a>r>down=resize_split:down,150

keybind = ctrl+a>r>l=resize_split:right,10
keybind = ctrl+a>r>h=resize_split:left,10
keybind = ctrl+a>r>k=resize_split:up,10
keybind = ctrl+a>r>j=resize_split:down,10

keybind = ctrl+a>p>z=toggle_split_zoom
